# SpacetimeDB connection (Vite exposes VITE_* to the client).
VITE_STDB_URI=ws://localhost:3000
VITE_STDB_DB=kalulu

# Cloudinary (image storage + CDN + on-the-fly thumbnails).
# Cloud name is public; the preset must be an UNSIGNED upload preset.
# No API key/secret here — unsigned uploads don't use them.
VITE_CLOUDINARY_CLOUD_NAME=dzgfrvhjf
VITE_CLOUDINARY_UPLOAD_PRESET=kalulu_unsigned
