# ============================================================================
# Kalulu — project-wide environment template. Copy to .env and fill in.
# Per-app envs live in web/.env and the worker's wrangler secrets.
# ============================================================================

# --- SpacetimeDB ---
# Local dev: ws://localhost:3000  |  Cloud: wss://maincloud.spacetimedb.com
STDB_URI=ws://localhost:3000
STDB_DB=kalulu

# --- Cloudflare R2 / image worker ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kalulu-uploads
IMG_PUBLIC_BASE=https://img.kalulu.app
UPLOAD_TOKEN=change-me

# --- AI moderation (optional; AWS Rekognition) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- CI/CD (GitHub Actions secrets, not committed) ---
# SPACETIMEDB_TOKEN   - `spacetime login` token for publishing
# CLOUDFLARE_API_TOKEN - for wrangler deploy
